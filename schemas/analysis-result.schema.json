{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/dikwp/verityweave/schemas/analysis-result.schema.json",
  "title": "VerityWeave Analysis Result",
  "type": "object",
  "required": ["version", "case_digest", "decision", "confidence", "semantic_control_potential", "signals", "worlds", "interventions", "repair_card", "invariants", "provenance"],
  "properties": {
    "version": {"type": "string"},
    "case_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "semantic_control_potential": {"type": "number", "minimum": 0, "maximum": 1},
    "protected_expression": {"type": "boolean"},
    "high_impact": {"type": "boolean"},
    "signals": {"type": "object", "minProperties": 15},
    "worlds": {"type": "array", "minItems": 2},
    "graph": {"type": "object"},
    "interventions": {"type": "array"},
    "repair_card": {"type": "object"},
    "commons_support": {"type": "object"},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "invariants": {"type": "object"},
    "provenance": {"type": "object"},
    "validation": {"$ref": "runtime-validation.schema.json"}
  },
  "additionalProperties": true
}
