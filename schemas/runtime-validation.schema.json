{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local generated-output validation receipt",
  "description": "Checks on this reference implementation's generated output, not certification or enforcement of an external platform.",
  "type": "object",
  "required": ["schema_version", "scope", "passed", "checks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scope": {"const": "local_generated_output_only"},
    "passed": {"type": "boolean"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL", "NOT_VERIFIED"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
